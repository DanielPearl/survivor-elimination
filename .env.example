# Kalshi creds — the dashboard never reads these, but the live scorer
# does so it can pull active KXSURVIVOR markets.
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=/root/kalshi/Secret Keys/kalshi_api_key.txt

# Reddit ingestion — optional. Without it the live scorer still runs;
# the Reddit-derived columns just default to zero so the model relies
# on the on-show signals only.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=survivor-elimination/0.1
